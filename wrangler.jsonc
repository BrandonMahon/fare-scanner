{
  // Fare Board on Cloudflare Workers: static site from docs/, live data from
  // the repo at /data/*, and /api/* for the admin page. Protected by
  // Cloudflare Access (Worker → Access tab). GITHUB_TOKEN is a secret set
  // with `npx wrangler secret put GITHUB_TOKEN`, never in this file.
  // Deploy site code changes with `npm run deploy`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fare-board",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-20",
  "routes": [{ "pattern": "fares.brandonmahon.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/data/*"]
  },
  "vars": {
    "GITHUB_REPO": "BrandonMahon/fare-scanner",
    "GITHUB_BRANCH": "main"
  },
  "observability": { "enabled": true },
  // Local `wrangler dev` only: simulates a signed-in Access user.
  "access": { "dev": { "aud": "local-dev", "identity": { "email": "dev@example.com" } } }
}
